      "func toleratesBurstNode(tolerations []corev1.Toleration) bool {",
      "\tfor _, toleration := range tolerations {",
      "\t\tif toleration.Key != workload.LabelBurstNode ||",
      "\t\t\t(toleration.Effect != \"\" && toleration.Effect != corev1.TaintEffectNoSchedule) {",
      "\t\t\tcontinue",
      "\t\t}",
      "\t\tswitch toleration.Operator {",
      "\t\tcase corev1.TolerationOpExists:",
      "\t\t\treturn true",
      "\t\tcase \"\", corev1.TolerationOpEqual:",
      "\t\t\tif toleration.Value == \"true\" {",
      "\t\t\t\treturn true",
      "\t\t\t}",
      "\t\t}",
      "\t}",
      "\treturn false"
    ],
