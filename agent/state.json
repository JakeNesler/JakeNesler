    "lines": [
      "func CalculateSMA(bars []*interfaces.Bar, period int) float64 {",
      "\tif len(bars) < period {",
      "\t\treturn 0",
      "\t}",
      "",
      "\tsum := 0.0",
      "\tstart := len(bars) - period",
      "\tfor i := start; i < len(bars); i++ {",
      "\t\tsum += bars[i].Close",
      "\t}",
      "",
      "\treturn sum / float64(period)",
      "}"
    ],
