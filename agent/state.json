      "func gpuShapeRejectionReason(backend string, gpu *backends.GPUSpec) string {",
      "\tmapGPU := gpuTypeMapperFor(backend)",
      "\tif mapGPU == nil {",
      "\t\treturn state.PlacementRejectGPUKindNotSupported",
      "\t}",
      "\tif len(gpu.SKUs) > 0 {",
      "\t\t// A pinned SKU is refused by every current backend: none launches",
      "\t\t// GPUSpec.SKUs exactly, so pricing one and launching another is the",
      "\t\t// failure this refusal exists to prevent.",
      "\t\treturn state.PlacementRejectSKUNotSupported",
      "\t}",
      "\tcount := max(1, gpu.Count)",
      "\tif _, err := mapGPU(&backends.GPUSpec{Kind: gpu.Kind, Count: 1}); err != nil {",
      "\t\treturn state.PlacementRejectGPUKindNotSupported",
      "\t}",
      "\tif _, err := mapGPU(&backends.GPUSpec{Kind: gpu.Kind, Count: count}); err != nil {"
