    "lines": [
      "func calculateEMA(bars []*interfaces.Bar, period int) float64 {",
      "\tif len(bars) < period {",
      "\t\treturn bars[len(bars)-1].Close",
      "\t}",
      "",
      "\tmultiplier := 2.0 / float64(period+1)",
      "",
      "\t// Start with SMA",
      "\tema := CalculateSMA(bars[:period], period)",
      "",
      "\t// Calculate EMA for remaining bars",
      "\tfor i := period; i < len(bars); i++ {",
      "\t\tema = (bars[i].Close * multiplier) + (ema * (1 - multiplier))",
      "\t}",
      "",
      "\treturn ema"
    ],
