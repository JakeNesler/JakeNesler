    "lines": [
      "func calculateMomentum(bars []*interfaces.Bar) *MomentumResult {",
      "\tif len(bars) < 6 {",
      "\t\treturn nil",
      "\t}",
      "",
      "\tcurrent := bars[len(bars)-1].Close",
      "\tday1 := bars[len(bars)-2].Close",
      "\tday5 := bars[len(bars)-6].Close",
      "",
      "\treturn &MomentumResult{",
      "\t\tPriceChange1D:   current - day1,",
      "\t\tPriceChange5D:   current - day5,",
      "\t\tPercentChange1D: ((current - day1) / day1) * 100,",
      "\t\tPercentChange5D: ((current - day5) / day5) * 100,",
      "\t}",
      "}"
    ],
    "url": "https://github.com/JakeNesler/OpenProphet/blob/3614481088b26ecd0c823272e826da27428dbcf3/services/technical_analysis.go#L200-L215"
