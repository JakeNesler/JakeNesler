    "lines": [
      "func gpuAdmissionRefusalReason(err error, backend string, gpu *backends.GPUSpec) (string, bool) {",
      "\tswitch {",
      "\tcase errors.Is(err, errGPUPriceCapNotFinite):",
      "\t\treturn \"\", false",
      "\tcase errors.Is(err, errGPUPriceCapExceeded), errors.Is(err, errAWSGPUPriceUnverifiable):",
      "\t\t// Both are the per-GPU ceiling refusing the placement: one because the",
      "\t\t// resolved price is over it, the other because no price central trusts",
      "\t\t// can prove it is under it.",
      "\t\treturn state.PlacementRejectPriceAboveMaxHourly, true",
      "\t}",
      "\tif gpu == nil {",
      "\t\treturn state.PlacementRejectSKUNotSupported, true",
      "\t}",
      "\treturn gpuShapeRejectionReason(backend, gpu), true",
      "}"
    ],
