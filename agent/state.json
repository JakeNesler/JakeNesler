      "\tswitch key {",
      "\tcase workload.LabelBurstNode:",
      "\t\treturn value == \"true\"",
      "\tcase k8sv1.LabelNvidiaGPUPresent:",
      "\t\treturn value == \"true\" && spec.GPU != nil",
      "\tcase k8sv1.LabelGPUKind:",
      "\t\treturn spec.GPU != nil && spec.GPU.Kind != \"\" && value == spec.GPU.Kind",
      "\tcase k8sv1.LabelGPUCount:",
      "\t\tif spec.GPU == nil {",
      "\t\t\treturn false",
      "\t\t}",
      "\t\treturn value == k8sv1.GPUCountLabelValue(spec.GPU.Count)",
      "\tcase k8sv1.LabelProviderClass:",
      "\t\tbackend := strings.TrimSpace(spec.Backend)",
      "\t\treturn backend != \"\" && backend != \"auto\" && value == backend"
